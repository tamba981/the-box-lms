# ---------------------------------------------------------------------------
# Wuteve Global Academy — backend configuration
# Copy to `backend/.env` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

PORT=5000

# MongoDB connection string. For a local server: mongodb://127.0.0.1:27017/wuteve
MONGODB_URI=

# --- Secrets -----------------------------------------------------------------
# REQUIRED in production. Each must be at least 32 characters and unique.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if either is missing or still the
# placeholder value that appears in the source code.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- URLs --------------------------------------------------------------------
# Must be the address a real user can reach: it is used in email links and as
# the Stripe redirect target. In production set it to your public domain.
PUBLIC_BASE_URL=http://localhost:5000

# Comma-separated list of origins allowed to call the API from a browser.
# Leave blank when the pages are served by this same server.
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Email (optional) --------------------------------------------------------
# Without a key, verification and reset links are written to the server log
# instead of being delivered, so the flows remain testable locally.
# RESEND_API_KEY=
# EMAIL_FROM=Wuteve Global Academy <no-reply@your-domain.com>

# --- Payments (optional) -----------------------------------------------------
# Without these, free courses work fully and paid checkout returns a clear 503.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=debug
