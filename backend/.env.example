# ---------------------------------------------------------------------------
# Wuteve Global Academy — backend configuration
# Copy to `backend/.env` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

PORT=5000

# MongoDB connection string. For a local server: mongodb://127.0.0.1:27017/wuteve
MONGODB_URI=

# --- Secrets -----------------------------------------------------------------
# REQUIRED in production. Each must be at least 32 characters and unique.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if either is missing or still the
# placeholder value that appears in the source code.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- URLs --------------------------------------------------------------------
# The address a real user can reach, with no trailing slash. It is the link
# inside every verification and password-reset email, and the address a payment
# returns to, so in production it must be the public domain:
#
#   local development   http://localhost:5000
#   production          https://wuteveglobalacademy.com
#
# It stays localhost here on purpose: this is where *this* instance is
# reachable, and pointing it at the live domain while developing would put live
# links into test emails. The domain belongs in Railway's variables, not here.
PUBLIC_BASE_URL=http://localhost:5000

# Comma-separated list of origins allowed to call the API from a browser.
# Leave blank when the pages are served by this same server.
# CORS_ORIGINS=https://wuteveglobalacademy.com,https://www.wuteveglobalacademy.com

# --- Email (optional) --------------------------------------------------------
# Without a key, verification and reset links are written to the server log
# instead of being delivered, so the flows remain testable locally.
# RESEND_API_KEY=
# EMAIL_FROM=Wuteve Global Academy <no-reply@wuteveglobalacademy.com>

# Where the forms deliver. Both have default addresses in src/config/env.js, so
# neither has to be set; override them only to route the mail somewhere else
# (a shared inbox while testing, for instance).
#   CONTACT_INBOX   the contact page and general notifications
#   BUSINESS_INBOX  enquiries from business.html, universities.html and
#                   government.html - they need somebody who can talk about
#                   contracts, invoicing and cohort dates
# CONTACT_INBOX=info@wuteveglobalacademy.com
# BUSINESS_INBOX=partnership@wuteveglobalacademy.com

# --- Payments (optional) -----------------------------------------------------
# Without these, free courses work fully and paid checkout returns a clear 503.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Mobile money (optional) -------------------------------------------------
# Orange Money Liberia and Lonestar Cell MTN MoMo. Each provider needs all four
# values below before it can be used; until then it is listed on the course page
# as switched off, naming whichever values are absent, and a charge attempt is
# refused rather than left hanging.
#
# The two charge calls are not implemented yet — see docs/PAYMENTS.md. Supplying
# these values makes a method selectable, not payable.
#
# CALLBACK_SECRET signs the provider's callback to this server. Use a long
# random value, the same way as the JWT secrets above, and give the provider the
# matching value.
#
# ORANGE_MONEY_BASE_URL=
# ORANGE_MONEY_MERCHANT_ID=
# ORANGE_MONEY_API_KEY=
# ORANGE_MONEY_CALLBACK_SECRET=
# ORANGE_MONEY_CURRENCY=lrd
#
# LONESTAR_MOMO_BASE_URL=
# LONESTAR_MOMO_MERCHANT_ID=
# LONESTAR_MOMO_API_KEY=
# LONESTAR_MOMO_CALLBACK_SECRET=
# LONESTAR_MOMO_CURRENCY=lrd

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=debug
