{
  "name": "wuteve-global-academy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Wuteve Global Academy — learning platform API",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/check.js",
    "test": "node scripts/smoke.js",
    "verify": "npm run build && node scripts/smoke.js",
    "build:deploy": "node scripts/check.js && node scripts/stage-pages.js",
    "verify:deploy": "node scripts/verify-deploy.js",
    "new-secrets": "node scripts/new-secrets.js",
    "check:mongo-uri": "node scripts/check-mongo-uri.js",
    "db:inspect": "node scripts/db-inspect.js",
    "env:init": "node scripts/init-env.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  }
}
