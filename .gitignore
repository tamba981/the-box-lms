# Dependencies - NEVER commit these
node_modules/
.next/
out/
dist/
build/

# Large binary files
*.node
*.exe
*.dll
*.so

# Environment
#
# `.env.backup` used to be committed: it is not matched by any of the narrower
# patterns below, and it holds the MongoDB connection string (with its password)
# and the JWT signing secret. Ignore every `.env*` file and re-admit only the
# template, which contains placeholders and no real values.
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test and runtime artefacts
coverage/
*.tmp

# The static pages copied beside the app at build time by
# scripts/stage-pages.js. Generated, and the originals live in frontend/public.
backend/public/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
